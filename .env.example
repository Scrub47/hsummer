# Copy to .env.local and fill in. .env.local is gitignored.
# Restart `npm run dev` after changing NEXT_PUBLIC_ values.
# On Vercel, set the same names for Production and Preview, then redeploy
# so the public values are baked into the browser bundle.

# --- Supabase (Project Settings → API keys) ---
# Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public key, safe in the browser. New projects: the publishable key
# (sb_publishable_...). It replaces the legacy anon key and still respects RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Legacy name. Used only when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty.
# Leave blank if you filled in the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. New projects: the secret key (sb_secret_...). It replaces the
# legacy service_role key. It bypasses RLS. Never prefix it with NEXT_PUBLIC_.
# Thinking of You uses it to reach the recipient's devices. It does not insert
# pings. The QStash callback uses it to deliver a scheduled letter.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Legacy name. Used only when SUPABASE_SECRET_KEY is empty.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (npm run generate:vapid) ---
# Public key. Safe in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Server only.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact for the push service. mailto: or https:. Not the example address.
VAPID_SUBJECT=mailto:you@example.com

# --- Rate limits (optional) ---
# When both are set, pings, new invite links, invite redemption, memories,
# and sign-in use an Upstash Redis sliding window before the database check.
# When either is empty, those limits stay in Postgres and the app still works.
# If these are already set on Vercel, leave them alone.
# The REST URL is a normal Config variable. The token is the sensitive one,
# stored as a Secret.
# UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Scheduled letters (optional) ---
# Upstash QStash is global. There is no region. Redis above stays us-west-2.
# Console: console.upstash.com → left sidebar QStash (not Redis).
# QSTASH_TOKEN is on the QStash page. The two signing keys are on the
# Signing Keys tab (current, then next).
# On Vercel, add all three as Sensitive for Production and Preview.
# Development cannot store Sensitive variables. Skip Development, or add
# them there as plain variables. Then redeploy.
# When any one is missing, a letter set for later still saves and arrives
# the next time someone in the circle opens the app after that time.
# QSTASH_TOKEN=your-qstash-token
# QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
# QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# --- Bot check on sign-in (optional) ---
# Public site key from a Cloudflare Turnstile widget. Safe in the browser.
# On Vercel, set it for Production and Preview as a Config variable, not a
# Secret: Next inlines NEXT_PUBLIC_ values into the client bundle.
# Leave it empty to keep the widget off.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Server only. Same secret you paste into the Supabase dashboard. Google
# sign-in checks the widget here, because Auth does not run captcha on
# /authorize. Do not prefix this with NEXT_PUBLIC_. On Vercel it is a Secret
# for Production and Preview. Leave it empty while the site key is empty.
# A Turnstile token works once. Magic link does not check it here; Supabase
# does, on /otp, when dashboard captcha is on.
# TURNSTILE_SECRET_KEY=your-turnstile-secret

# The weekly database backup does not read this file. Its connection string
# and passphrase are GitHub Actions secrets. See the week 6 section of the
# README. Do not set E2E_TEST_AUTH here or on Vercel. That flag only belongs
# on the local Playwright run.

# Public origin of this app.
# Local (.env.local): http://localhost:3000
# Vercel Production:  https://hsummer.vercel.app
#   (the project must be named "hsummer" to get that address; hsummer.app can
#   replace it later). Also add both origins to Supabase redirect URLs:
#   http://localhost:3000/auth/callback
#   https://hsummer.vercel.app/auth/callback
# Magic-link and Google redirects use the browser's origin, so a preview
# deploy works only after that preview URL is on the same allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
